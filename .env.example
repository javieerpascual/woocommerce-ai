# ==========================================
# WordPress / WooCommerce
# ==========================================
WP_URL=http://tu-sitio.local
WP_USER=tu_usuario
WP_APP_PASSWORD=tu_app_password

# WooCommerce REST API Keys
# Genera las keys desde: WooCommerce > Ajustes > Avanzado > REST API
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# Ollama (IA local)
# ==========================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ==========================================
# Servidor
# ==========================================
PORT=3001
